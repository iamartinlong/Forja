{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "forja-build": {
      "description": "FORJA 锻造执行代理，严格按 Spec 生成代码与测试",
      "mode": "primary",
      "model": "forja/deepseek-v4-flash",
      "temperature": 0.2,
      "tools": {
        "bash": false,
        "edit": false,
        "patch": false,
        "write": false
      }
    },
    "forja-plan": {
      "description": "FORJA 图纸审查代理，只读分析 Spec",
      "mode": "primary",
      "model": "forja/deepseek-v4-flash",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "temperature": 0.1,
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      }
    }
  },
  "permission": "allow",
  "plugin": [],
  "provider": {
    "forja": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        }
      },
      "name": "Forja DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:FORJA_API_KEY}",
        "baseURL": "https://opencode.ai/zen/go/v1"
      }
    },
    "opencode": {
      "models": {
        "mimo-v2.5": {
          "name": "MiMo-V2.5"
        }
      },
      "name": "opencode-go",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:FORJA_API_KEY}",
        "baseURL": "https://opencode.ai/zen/go/v1"
      }
    }
  }
}